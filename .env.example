# Apollo — environment variables
# Copy to .env (gitignored) and fill in. Vite exposes anything prefixed
# with VITE_ to the client bundle. Restart `pnpm dev` after editing.

# ─── Formspree ──────────────────────────────────────────────────────────
# Endpoint that receives waitlist submissions. Without this, the form
# runs in stub mode (shows success but does NOT send the lead anywhere).
# Setup: https://formspree.io/ → create form → copy the full URL.
VITE_FORMSPREE_ENDPOINT=

# ─── PostHog (analytics) ────────────────────────────────────────────────
# Project API key (starts with phc_). Get it at PostHog → Settings →
# Project → Project API Key.
VITE_POSTHOG_KEY=

# Host. Default is US cloud. For Brazilian companies, EU is generally
# preferred for LGPD posture. Pick the host you chose at signup.
#   US: https://us.i.posthog.com
#   EU: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
